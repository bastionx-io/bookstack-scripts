[Unit]
Description=BookStack encrypted outbound backup
Wants=network-online.target
After=network-online.target mysql.service
ConditionPathExists=/etc/bookstack-dr-backup/config

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=BOOKSTACK_BACKUP_CONFIG=/etc/bookstack-dr-backup/config
ExecStart=/usr/local/sbin/bookstack-dr-backup

# Avoid competing aggressively with the production application.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=25%
MemoryHigh=384M
MemoryMax=512M
IOWeight=10
TimeoutStartSec=30min
TimeoutStopSec=15s
KillMode=control-group
LimitCORE=0

# Basic hardening. The script only writes to its state/runtime directories and
# uploads over the network. Keep these settings under test with the production
# MySQL socket, BookStack paths, and installed AWS CLI.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/var/www/bookstack
ReadWritePaths=/var/lib/bookstack-dr-backup /run/bookstack-dr-backup

StateDirectory=bookstack-dr-backup
StateDirectoryMode=0700
RuntimeDirectory=bookstack-dr-backup
RuntimeDirectoryMode=0700
